# PostgreSQL password — REQUIRED (compose fails to start if unset).
# This dev placeholder is fine on a localhost-only box; MUST change in
# production (generate with: openssl rand -hex 32).
POSTGRES_PASSWORD=onden

# Auth secret. Leave BLANK for zero-config: the backend auto-generates a strong
# random secret on first boot and persists it to the content volume. Set it
# only to pin the secret across hosts/replicas (generate: openssl rand -hex 32).
BETTER_AUTH_SECRET=

# Public URL of the deployment (used for auth callbacks and allowed sign-in origin).
# On a physical phone, localhost means the phone itself. Use the server's LAN
# address or HTTPS hostname here, including its port when not 80/443.
APP_URL=http://localhost
# Where the backend asks the frontend for each site page when it builds the zip download and the
# GitHub Pages push (compose sets http://frontend; local dev: the frontend dev server).
# SITE_SSR_URL=http://localhost:4321

# If both the public address and desktop localhost should allow sign-in, list
# those exact origins (scheme + hostname + port), without paths or trailing /.
# This also supplies better-auth's trustedOrigins; do not use a wildcard.
#CORS_ORIGIN=http://localhost,http://192.168.1.10
# Recreate the backend after changing these values; a browser reload or a plain
# container restart does not load updated Compose environment values.

# Who may create an account. first-only (default): only the first account,
# which becomes the owner; later sign-ups, including first-time OAuth logins,
# are refused, except through a one-time invite link the owner made in
# Settings › Users & Agents, with the invited email (its first sign-in takes the
# role and spaces the owner set).
# open: anyone who can reach the server may register (as a viewer).
#ONDEN_SIGNUP=first-only

# The largest backup zip Settings › Your data › Restore accepts, in MB (default 16384 = 16 GB; a backup downloads at any
# size). Needs free disk for the upload (the file is kept on disk, not in memory). If you change it, give nginx the same
# number: `client_max_body_size <MB>m;` in the `location = /api/backup/restore/upload` block of docker/nginx/nginx.conf,
# or nginx refuses a larger file first.
#ONDEN_MAX_BACKUP_MB=16384

# Paragraph anchors (docs/architecture/proposals/block-anchors-2026-11-01.md, batch 0, shadow mode):
# "off" stops moving, shipping and backing up the anchor table; the table stays. Unset = on.
#ONDEN_BLOCK_ANCHORS=off

# Where "today" turns over (task due dates, the agenda, the day lens, the review
# day): an IANA time zone. Unset = UTC, so in Taiwan the day would change at 08:00.
#ONDEN_TIMEZONE=Asia/Taipei

# Encrypts the API keys pasted in Settings › 空間與成員 (the API way of
# running AI). 32 bytes: openssl rand -hex 32. Unset = no API option anywhere.
# Keep a copy apart from the backups; losing it makes the stored keys unreadable.
#ONDEN_SECRET_KEY=

# Lock-screen task reminders (Web Push). Set all three or none; unset = the
# feature does not appear. Generate the pair once (docs/agents/deploy.md) and
# keep it: a new pair makes every device subscribe again.
# VAPID_SUBJECT is who the push services can contact: mailto:you@example.com or https://your.site
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=

# Scheduled backups (compose service `backup`): a pg_dump and a tar of the
# media/git volume every BACKUP_INTERVAL_HOURS, newest BACKUP_KEEP kept.
# Use an absolute path when compose.yaml lives in a per-release directory,
# otherwise each deploy starts a new, empty backups folder.
#ONDEN_BACKUP_DIR=./backups
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP=14

# Host port nginx listens on. With the bundled HTTPS (below) set this to
# 127.0.0.1:8080 instead: Caddy takes 80/443, and 127.0.0.1: keeps plain HTTP
# off the internet.
APP_PORT=80

# ── HTTPS (optional) ──────────────────────────────────────────────────────────
# Phones, installing the app (PWA), offline mode and the clipboard only work on
# https:// (or localhost). Three ways to get it: docs/self-host/https.md
#
# 1) Bundled Caddy gets a free Let's Encrypt certificate by itself. Set the
#    three values, APP_PORT=127.0.0.1:8080 above, APP_URL=https://<domain>, then:
#      docker compose --profile https up -d
#    The domain's DNS must already point at this server, and 80/443 be open.
#ONDEN_DOMAIN=onden.example.com
#ONDEN_ACME_EMAIL=you@example.com
#
# Real client IP (login rate limit): nginx tells the client's address from the
# connection, and trusts a forwarded address ONLY from the bundled Caddy (on a
# private port that is never published). Anything a browser sends in
# X-Real-IP / X-Forwarded-For is discarded. If your own proxy sits in front of
# nginx, see "已經有反向代理" in docs/self-host/https.md before trusting it.

# ── OAuth social login (optional) ─────────────────────────────────────────────
# Lets users sign in with GitHub / Google instead of email+password. Entirely
# OPT-IN: a provider turns ON only when BOTH its client id AND secret are set
# below — leave them blank and the login screen shows the normal email/password
# form unchanged (nothing crashes, no buttons appear). Secrets are read from the
# environment only and are never sent to the browser.
#
# To enable, register an OAuth app with the provider and set the Authorization
# callback URL to:   ${APP_URL}/api/auth/callback/<provider>
#   GitHub:  https://github.com/settings/developers      → callback ${APP_URL}/api/auth/callback/github
#   Google:  https://console.cloud.google.com/apis/credentials → callback ${APP_URL}/api/auth/callback/google
# (For local dev with APP_URL=http://localhost that is e.g.
#  http://localhost/api/auth/callback/github)
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# Semantic search runs LOCALLY and PRIVATELY by default (multilingual-e5-small
# via Transformers.js — no data leaves the box; install once with
# `npm install @huggingface/transformers`). Set EMBEDDING_MODE=stub for a
# non-semantic offline fallback (also the default under tests/CI).
#EMBEDDING_MODE=local

# ── AI ────────────────────────────────────────────────────────────────────────
# Onden has no AI key of its own. An AI either reaches in as an MCP client (mint an
# access token for it in Settings) or runs on this server with a key YOU add in
# Settings, for any service: you give its address and key, and Onden detects the
# format (/v1/messages or /v1/chat/completions). See docs/architecture/harness.md.
#
# Testing only: send every API key to one service.
#ONDEN_AI_BASE_URL_OVERRIDE=

# Self-hosting: pin the release the prebuilt images come from (default: latest
# release). `docker compose pull && docker compose up -d`. Running from source
# (docker compose up --build)? Set ONDEN_VERSION=local so local builds never
# share a name with pulled releases. See docs/agents/release.md.
# ONDEN_VERSION=latest
# The images' name prefix (default ghcr.io/oandy-rgb/onden → …/onden-backend).
# The VPS sets ONDEN_IMAGE=onden-vps so its builds keep the onden-vps-<svc>:latest
# names its rollback tags use (docs/agents/deploy.md).
# ONDEN_IMAGE=ghcr.io/oandy-rgb/onden
