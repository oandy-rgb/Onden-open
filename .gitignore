/clone/
.claude-sandbox-home/
.claude/*
!.claude/settings.json
skills-lock.json

# Benchmark output (npm run bench); budgets are in bench-budgets.json
/.bench/
/bench-results.json

# Mutation testing output (npm run test:mutation)
reports/
.stryker-tmp/
stryker-setup-*.js

# browser app smoke test leftovers
packages/frontend/e2e/browser-app/failed-*.png

# generated by e2e/scripts/writeHostContract.ts (run.sh, npm run check:specs)
packages/frontend/e2e/fullstack/generated/
