.claude/settings.local.json

# Environment / secrets
.env
.env.*
!.env.example
# Local acceptance evidence and full database/content backups are not source.
/.acceptance/
/backups/
# Per-machine Compose settings (automatically loaded beside compose.yaml).
/compose.override.yaml
Onden-backend/.env
Onden-frontend/.env

# Dependencies
node_modules/
Onden-backend/node_modules/
Onden-frontend/node_modules/

# Build output
dist/
Onden-backend/dist/
Onden-frontend/dist/
Onden-frontend/.astro/
Onden-frontend/dist-cap/
# Repo-root Astro cache (current monorepo layout: packages/frontend)
.astro/
packages/frontend/.astro/
packages/frontend/dist/
packages/frontend/dist-cap/
packages/frontend/dist-browser/
packages/frontend/dist-browser-sizes.json
packages/backend/dist/

# Runtime content stores
content/
Onden-backend/content/

# Logs
*.log

# Android generated/local files
Onden-frontend/android/.gradle/
Onden-frontend/android/**/build/
Onden-frontend/android/local.properties
Onden-frontend/android/capacitor-cordova-android-plugins/
Onden-frontend/android/app/src/main/assets/
Onden-frontend/android/app/src/main/res/xml/config.xml

# Reference/competitor clones for mechanism surveys (NOT part of onden; mixed
