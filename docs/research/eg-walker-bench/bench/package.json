{
  "name": "eg-walker-bench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Eg-walker 合併速度研究測試台（獨立套件，不進主程式依賴與打包）",
  "scripts": {
    "bench:node": "tsx src/runNode.ts",
    "bench:browser": "tsx src/runBrowser.ts",
    "bench:compare": "tsx src/runCompare.ts",
    "bench:size": "tsx src/runSize.ts",
    "test": "tsx --test src/test/*.test.ts",
    "test:tiebreak": "tsx --test src/tiebreak/tiebreak.test.ts"
  },
  "dependencies": {
    "binary-search": "1.3.6",
    "priorityqueuejs": "2.0.0",
    "diamond-types-node": "1.0.2",
    "diamond-types-web": "1.0.2"
  },
  "devDependencies": {
    "esbuild": "0.27.7",
    "playwright": "1.63.0",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "@types/node": "22.19.21",
    "@types/priorityqueuejs": "1.0.4"
  }
}
