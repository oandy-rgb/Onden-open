{
  "name": "onden",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/*",
    "!packages/desktop"
  ],
  "scripts": {
    "notices": "node scripts/thirdPartyNotices.mjs",
    "notices:check": "node scripts/thirdPartyNotices.mjs --check",
    "test:fuzz": "npm run test:fuzz --workspaces --if-present",
    "test:fuzz:long": "npm run test:fuzz:long --workspaces --if-present",
    "preflight": "npm run preflight:backend && npm run preflight:frontend",
    "preflight:backend": "cd packages/backend && npx tsc --noEmit",
    "preflight:frontend": "cd packages/frontend && npx tsc --noEmit && npm run build",
    "test:props": "npm -w packages/backend run test:props",
    "test:props:long": "npm -w packages/backend run test:props:long",
    "test:sync-sim": "cd packages/frontend && vitest run src/test/properties/syncFaultSimulation.integration.property.test.ts",
    "postinstall": "patch-package --error-on-fail",
    "build:browser": "node scripts/build-browser.mjs",
    "deploy:browser": "node scripts/deploy-browser.mjs",
    "scan:browser": "node scripts/browserReleaseScan.mjs",
    "capture:client-writes": "node packages/frontend/scripts/client-writes/capture.mjs",
    "bench": "node scripts/bench/run.mjs",
    "bench:seed": "cd packages/backend && npx tsx scripts/bench/seed.ts",
    "bench:check": "node scripts/bench/check.mjs",
    "test:mutation": "npm run test:mutation -w packages/backend -w packages/frontend -w packages/markdown",
    "dup": "node scripts/dup.mjs",
    "dup:check": "node scripts/dup.mjs --check",
    "dup:baseline": "node scripts/dup.mjs --write-baseline",
    "dup:names": "node scripts/dupNames.mjs --check",
    "dup:names:baseline": "node scripts/dupNames.mjs --write-baseline",
    "dup:near": "node scripts/dupNear.mjs",
    "dup:near:check": "node scripts/dupNear.mjs --check",
    "dup:near:baseline": "node scripts/dupNear.mjs --write-baseline",
    "test:repeat-changed": "bash scripts/repeat-changed-tests.sh",
    "changes:check": "node scripts/changes.mjs",
    "docs:covered": "node scripts/check-md-links.mjs --covered",
    "allowlist:baseline": "node scripts/allowlist.mjs",
    "appearance:tokens": "node packages/frontend/scripts/appearanceTokens.mjs --doc",
    "surface:baseline": "node scripts/surface.mjs",
    "catalog": "node scripts/catalog.mjs",
    "ratchet:check": "node scripts/ratchet.mjs",
    "unused:check": "node scripts/unusedCode.mjs --check",
    "unused:shrink": "node scripts/unusedCode.mjs --shrink",
    "agents:tables": "node scripts/agentsTables.mjs",
    "desktop:install": "npm ci --prefix packages/desktop",
    "desktop:dev": "npm run dev --prefix packages/desktop",
    "desktop:build": "npm run build --prefix packages/desktop",
    "desktop:test": "npm run test --prefix packages/desktop",
    "desktop:pack": "npm run pack --prefix packages/desktop",
    "desktop:check": "node scripts/desktopCheck.mjs",
    "parity": "node packages/frontend/e2e/parity/run.mjs",
    "parity:test": "node --test packages/frontend/e2e/parity/parity.test.mjs",
    "desktop:smoke": "npm run test:smoke --prefix packages/desktop",
    "check": "npm run preflight && npm run dup:check && npm run dup:names && npm run dup:near:check"
  },
  "dependencies": {
    "unist-util-visit": "^5.1.0"
  },
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "use-sync-external-store": "1.6.0",
    "clsx": "2.1.1",
    "hono": "^4.13.11",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "jscpd": "5.4.2",
    "patch-package": "^8.0.1"
  }
}
