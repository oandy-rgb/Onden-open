{
  "name": "onden-backend",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "db:types": "tsx scripts/db-types.ts",
    "test": "vitest run",
    "test:no-db": "ONDEN_TESTS_WITHOUT_DATABASE=1 vitest run",
    "test:pglite": "ONDEN_DB_DRIVER=pglite DATABASE_URL=postgres://x@localhost/onden_cloud_test vitest run --maxWorkers=3",
    "test:watch": "vitest",
    "test:fuzz": "vitest run --config vitest.fuzz.config.ts",
    "test:fuzz:long": "FUZZ_LONG=1 vitest run --config vitest.fuzz.config.ts",
    "test:real-pg": "node scripts/realPostgresTests.mjs",
    "test:isolated": "bash scripts/test-isolated.sh",
    "test:props": "vitest run src/test/properties",
    "test:props:long": "S=${PROPS_SEED:-$(date +%Y%m%d)}; echo \"PROPS_SEED=$S (replay: PROPS_SEED=$S PROPS_RUNS=5000)\"; PROPS_SEED=$S PROPS_RUNS=5000 vitest run src/test/properties",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test:mutation": "stryker run",
    "test:mutation:file": "stryker run --mutate"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@hono/node-server": "^1.14.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@octokit/rest": "^22.0.1",
    "@onden/contract": "*",
    "@onden/markdown": "*",
    "@onden/site": "*",
    "@types/web-push": "^3.6.4",
    "archiver": "^7.0.1",
    "better-auth": "^1.6.11",
    "diff": "^8.0.4",
    "diff-match-patch": "^1.0.5",
    "hono": "^4.13.13",
    "katex": "^0.16.47",
    "kysely": "^0.29.2",
    "node-ical": "^0.27.3",
    "octokit-commit-multiple-files": "^6.0.3",
    "pagefind": "^1.5.2",
    "pg": "^8.14.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.5",
    "simple-git": "^3.36.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "web-push": "^3.6.7",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@electric-sql/pglite-pgvector": "^0.0.15",
    "@noble/hashes": "^2.2.0",
    "@types/archiver": "^7.0.0",
    "@types/diff-match-patch": "^1.0.36",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.8.0",
    "fflate": "^0.8.3",
    "kysely-codegen": "^0.20.0",
    "path-browserify": "^1.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  }
}
