{
  "name": "onden-frontend",
  "version": "0.1.0",
  "sideEffects": [
    "*.css",
    "*.scss",
    "./src/AppRoot.tsx",
    "./src/browserApp/main.tsx",
    "./src/browserApp/temporaryEntry.ts",
    "./src/components/functionCatalog/index.ts",
    "./src/components/infoAi/index.ts",
    "./src/components/infoFunctions/index.ts",
    "./src/components/paragraphTools/index.ts",
    "./src/components/tagPage/strings.ts",
    "./src/hooks/useUrlLocation.ts",
    "./src/lib/api.ts",
    "./src/lib/appStore.ts",
    "./src/lib/blockSafety/index.ts",
    "./src/lib/data/draftActions.ts",
    "./src/lib/data/serverTruth.ts",
    "./src/lib/data/serverTruthLoad.ts",
    "./src/lib/data/syncEngine.ts",
    "./src/lib/data/writePositions.ts",
    "./src/lib/data/writeQueue.ts",
    "./src/lib/data/writeRecovery.ts",
    "./src/lib/i18n.app.ts",
    "./src/lib/localDbWorker.ts",
    "./src/lib/shortcuts.ts",
    "./src/main.tsx",
    "./src/modules/daily/day/strings.ts",
    "./src/modules/external_calendars/strings.ts",
    "./src/modules/index.ts",
    "./src/modules/slides/i18n.ts",
    "./src/modules/website/setup/siteWords.ts",
    "./src/settings/ai/strings.ts"
  ],
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "e2e:note-pages": "node e2e/browser-app/notePages.mjs chromium && node e2e/browser-app/notePages.mjs mobile-chrome",
    "e2e:quote-region": "node e2e/browser-app/quoteRegion.mjs chromium && node e2e/browser-app/quoteRegion.mjs mobile-chrome",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "check:specs": "bash e2e/scripts/checkSpecsLoad.sh",
    "e2e:webkit-scan": "bash e2e/fullstack/run.sh --config playwright.webkit-scan.config.ts",
    "e2e:cloud-stack": "node e2e/fullstack/cloud-stack.mjs",
    "e2e:probes": "cd e2e && npx playwright test --config probes/playwright.config.ts",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check-app-css.mjs && node scripts/check-worker-bundle.mjs app && node scripts/check-boot-bundle.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "build:cap": "vite build --config vite.capacitor.config.ts",
    "cap:sync": "npm run build:cap && npx cap sync android",
    "cap:open": "npx cap open android",
    "test": "vitest run",
    "test:no-db": "ONDEN_TESTS_WITHOUT_DATABASE=1 vitest run",
    "test:fuzz": "vitest run --config vitest.fuzz.config.ts",
    "test:fuzz:long": "FUZZ_LONG=1 vitest run --config vitest.fuzz.config.ts",
    "test:props": "vitest run src/test/properties",
    "test:props:long": "S=${PROPS_SEED:-$(date +%Y%m%d)}; echo \"PROPS_SEED=$S (replay: PROPS_SEED=$S PROPS_RUNS=5000)\"; PROPS_SEED=$S PROPS_RUNS=5000 vitest run src/test/properties",
    "test:astro": "vitest run --config vitest.astro.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "test:mutation": "stryker run",
    "test:mutation:file": "stryker run --mutate",
    "e2e:touch-hold": "node e2e/browser-app/touchHold.mjs",
    "e2e:slides": "node e2e/browser-app/slideTables.mjs chromium && node e2e/browser-app/slideTables.mjs mobile-chrome && node e2e/browser-app/slideTablesPptx.mjs && node e2e/browser-app/slideColumns.mjs",
    "layout:audit": "node e2e/layout-audit/run.mjs",
    "layout:audit:selftest": "node e2e/layout-audit/selftest.mjs",
    "lint:boundaries": "eslint -c eslint.boundaries.config.js src --quiet",
    "style:census": "node e2e/style-census/run.mjs",
    "style:census:selftest": "node e2e/style-census/selftest.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/node": "^11.1.14",
    "@astrojs/react": "^7.1.9",
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/noto-sans-tc": "^5.3.1",
    "@fontsource-variable/noto-serif-tc": "^5.3.1",
    "@fontsource/lxgw-wenkai-tc": "^5.3.1",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "@onden/contract": "*",
    "@onden/markdown": "*",
    "@onden/site": "*",
    "@puckeditor/core": "0.23.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.6.0",
    "astro": "^7.4.13",
    "better-auth": "^1.7.26",
    "docx": "^9.5.1",
    "fflate": "^0.8.3",
    "fuse.js": "^7.3.0",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "lucide-react": "^0.503.0",
    "lz-string": "^1.5.0",
    "mermaid": "^11.15.0",
    "oxc-transform-react": "^0.156.0",
    "pdfjs-dist": "6.2.108",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sql.js": "^1.14.1",
    "tailwindcss": "^4.3.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.17.0",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.8.0",
    "happy-dom": "^20.10.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "remark-stringify": "^11.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7",
    "vitest-axe": "^0.1.0"
  }
}
