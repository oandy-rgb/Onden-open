---
// The search of every published page: Pagefind (pagefind.app) over the notes' text, in a full-screen
// panel (a popover, so it sits above the page and closes on Esc or a tap outside) the header's button or Ctrl/⌘+K opens, on a phone as on a desktop. The index is made with
// the static copy and served from the same folder on the live site (lib/siteSearch.ts), so it finds the same
// notes live, in a zip and on a static host. The button shows whenever script runs (it is `hidden` in the
// HTML so a page without script has none); when the index cannot be reached — before the live site has one,
// or opened straight from disk (file://) — the panel says so instead of staying silent or hiding the button.
// No framework; the Pagefind files load on the first search. The markup is drawn with the header (SiteHeader in SiteFrames.tsx).
---

<script>
  import { excerptParts, hitHref, indexFolder, markTypedText, siteRoot } from "../../lib/siteSearch";

  type Hit = { url: string; meta: { title?: string; path?: string }; excerpt: string };
  type Pagefind = {
    options(o: { basePath: string }): Promise<void>;
    debouncedSearch(q: string, o: object, ms: number): Promise<{ results: Array<{ data(): Promise<Hit> }> } | null>;
  };

  const box = document.querySelector<HTMLElement>("[data-s-search]");
  const opener = document.querySelector<HTMLElement>("[data-s-search-open]");
  const link = document.querySelector<HTMLLinkElement>('link[rel="x-site-search"]');
  if (box && opener && link && location.protocol !== "file:") {
    opener.hidden = false;
    const folder = indexFolder(link.href);
    const root = siteRoot(folder);
    const input = box.querySelector("input")!;
    const list = box.querySelector<HTMLElement>(".s-search__results")!;
    let active = -1;
    let engine: Promise<Pagefind> | null = null;

    const isOpen = () => box.matches(":popover-open");
    const note = (className: string, text: string) => {
      const p = document.createElement("p");
      p.className = className;
      p.textContent = text;
      list.replaceChildren(p);
    };
    const open = () => {
      if (!isOpen()) box.showPopover();
      input.focus();
      input.select();
      // A missing index is said out loud, not left as a box that finds nothing.
      fetch(new URL("pagefind-entry.json", folder), { cache: "no-cache" })
        .then((res) => { if (!res.ok) note("s-search__empty", box.dataset.building ?? ""); })
        .catch(() => note("s-search__empty", box.dataset.building ?? ""));
    };
    const load = () => engine ??= (async () => {
      const pagefind = (await import(/* @vite-ignore */ new URL("pagefind.js", folder).href)) as Pagefind;
      await pagefind.options({ basePath: folder });
      return pagefind;
    })();

    const links = () => [...list.querySelectorAll<HTMLAnchorElement>("a.s-search__hit")];
    const mark = (i: number) => {
      links().forEach((a, n) => (n === i ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
      active = i;
    };
    const clear = () => { list.replaceChildren(); active = -1; };
    const marked = (parent: HTMLElement, parts: ReturnType<typeof excerptParts>) => {
      for (const part of parts) {
        if (part.mark) {
          const el = document.createElement("mark");
          el.className = "s-search__mark";
          el.textContent = part.text;
          parent.append(el);
        } else parent.append(part.text);
      }
    };

    opener.addEventListener("click", open);
    box.querySelector("[data-s-search-close]")!.addEventListener("click", () => box.hidePopover());
    // Esc and a tap outside close it by themselves (popover="auto"); what was typed goes with it.
    box.addEventListener("toggle", (e) => { if ((e as ToggleEvent).newState === "closed") { input.value = ""; clear(); } });
    window.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") { e.preventDefault(); if (isOpen()) box.hidePopover(); else open(); }
    });

    input.addEventListener("input", async () => {
      const q = input.value.trim();
      if (!q) return clear();
      try {
        const found = await (await load()).debouncedSearch(q, {}, 150);
        if (!found || input.value.trim() !== q) return; // a newer search took over
        const hits = await Promise.all(found.results.slice(0, 10).map((r) => r.data()));
        list.replaceChildren();
        if (hits.length === 0) {
          note("s-search__empty", `${box.dataset.noResults} 「${q}」${[...q].length === 1 ? ` ${box.dataset.more}` : ""}`);
        }
        for (const hit of hits) {
          const a = document.createElement("a");
          a.className = "s-search__hit";
          a.href = hitHref(root, hit.url);
          const title = document.createElement("strong");
          title.textContent = hit.meta.title ?? "";
          a.append(title);
          if (hit.meta.path) {
            const path = document.createElement("span");
            path.className = "s-path";
            path.textContent = hit.meta.path;
            a.append(path);
          }
          const excerpt = document.createElement("span");
          excerpt.className = "s-search__snippet";
          marked(excerpt, markTypedText(excerptParts(hit.excerpt), q));
          a.append(excerpt);
          a.addEventListener("mouseenter", () => mark(links().indexOf(a)));
          list.append(a);
        }
        mark(hits.length > 0 ? 0 : -1);
      } catch {
        // The index went away (a takedown rebuilt it): say so.
        note("s-search__empty", box.dataset.building ?? "");
      }
    });

    input.addEventListener("keydown", (e) => {
      const hits = links();
      if (e.key === "ArrowDown") { e.preventDefault(); mark(Math.min(active + 1, hits.length - 1)); }
      else if (e.key === "ArrowUp") { e.preventDefault(); mark(Math.max(active - 1, 0)); }
      else if (e.key === "Enter" && !e.isComposing && hits[active]) location.assign(hits[active]!.href);
    });
  }
</script>
