{
  "_format": "onden.tagpack/v1",
  "name": "book",
  "color": "#a47148",
  "description": "Reading log entry — one node per book you've read or are reading.",
  "version": "1.0.0",
  "fields": [
    { "name": "author",     "label": "Author",      "type": "text" },
    { "name": "isbn",       "label": "ISBN",        "type": "text" },
    { "name": "rating",     "label": "Rating",      "type": "number" },
    { "name": "status",     "label": "Status",      "type": "select", "options": ["to-read", "reading", "finished", "abandoned"] },
    { "name": "started_at", "label": "Started",     "type": "date" },
    { "name": "finished_at","label": "Finished",    "type": "date" },
    { "name": "cover_url",  "label": "Cover URL",   "type": "text" }
  ],
  "behaviour": {
    "schema_org": "https://schema.org/Book",
    "field_mappings": {
      "author":      "schema:author",
      "isbn":        "schema:isbn",
      "rating":      "schema:aggregateRating",
      "started_at":  "schema:dateRead",
      "cover_url":   "schema:image"
    }
  }
}
