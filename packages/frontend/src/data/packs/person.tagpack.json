{
  "_format": "onden.tagpack/v1",
  "name": "person",
  "color": "#5e8fb1",
  "description": "Personal CRM entry — log relationship, contact info and important dates.",
  "version": "1.0.0",
  "fields": [
    { "name": "relationship", "label": "Relationship", "type": "select", "options": ["family", "friend", "colleague", "professional", "acquaintance"] },
    { "name": "email",        "label": "Email",        "type": "text" },
    { "name": "phone",        "label": "Phone",        "type": "text" },
    { "name": "company",      "label": "Company",      "type": "text" },
    { "name": "role",         "label": "Role",         "type": "text" },
    { "name": "birthday",     "label": "Birthday",     "type": "date" },
    { "name": "last_contact", "label": "Last contact", "type": "date" }
  ],
  "behaviour": {
    "schema_org": "https://schema.org/Person",
    "field_mappings": {
      "email":    "foaf:mbox",
      "phone":    "schema:telephone",
      "company":  "schema:worksFor",
      "role":     "schema:jobTitle",
      "birthday": "schema:birthDate"
    }
  }
}
