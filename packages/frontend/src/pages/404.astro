---
// The not-found page. It used to come from Starlight (a docs theme with no
// docs left), which drew this same header and hero; the colours and sizes
// below are Starlight's defaults. Theme: the app's saved one, else the OS.
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 | Onden</title>
    <link rel="shortcut icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        var mode = localStorage.getItem("theme");
        if (mode === "light" || mode === "dark") document.documentElement.setAttribute("data-theme", mode);
      } catch (e) {
        /* storage unavailable: the OS preference applies */
      }
    </script>
    <style is:global>
      :root {
        --bg: hsl(224, 10%, 10%);
        --bg-nav: hsl(224, 14%, 16%);
        --hairline: hsl(224, 10%, 10%);
        --title-color: hsl(224, 100%, 85%);
        --heading: hsl(0, 0%, 100%);
        --text: hsl(224, 6%, 77%);
        --nav-height: 3.5rem;
        --nav-pad-x: 1rem;
        --title: 1.25rem;
        --h1: 1.8125rem;
        color-scheme: dark;
      }
      @media (prefers-color-scheme: light) {
        :root:not([data-theme="dark"]) {
          --bg: hsl(0, 0%, 100%);
          --bg-nav: hsl(224, 19%, 97%);
          --hairline: hsl(224, 20%, 94%);
          --title-color: hsl(234, 80%, 30%);
          --heading: hsl(224, 10%, 10%);
          --text: hsl(224, 10%, 23%);
          color-scheme: light;
        }
      }
      :root[data-theme="light"] {
        --bg: hsl(0, 0%, 100%);
        --bg-nav: hsl(224, 19%, 97%);
        --hairline: hsl(224, 20%, 94%);
        --title-color: hsl(234, 80%, 30%);
        --heading: hsl(224, 10%, 10%);
        --text: hsl(224, 10%, 23%);
        color-scheme: light;
      }
      @media (min-width: 50em) {
        :root { --nav-height: 4rem; --nav-pad-x: 1.5rem; --title: 1.5rem; }
      }
      * { box-sizing: border-box; margin: 0; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", Arial, sans-serif;
        line-height: 1.75;
        -webkit-font-smoothing: antialiased;
        color: var(--text);
        background-color: var(--bg);
      }
      header {
        display: flex;
        align-items: center;
        height: var(--nav-height);
        padding: 0.75rem var(--nav-pad-x);
        background-color: var(--bg-nav);
        border-bottom: 1px solid var(--hairline);
      }
      .site-title {
        font-size: var(--title);
        font-weight: 600;
        color: var(--title-color);
        text-decoration: none;
        white-space: nowrap;
      }
      main {
        max-width: calc(67.5rem + 2rem);
        margin-inline: auto;
        padding: 1.5rem 1rem 3vh;
      }
      .hero { display: grid; gap: 1rem; padding-bottom: 1rem; text-align: center; }
      @media (min-width: 50rem) {
        .hero { padding-block: clamp(2.5rem, calc(1rem + 10vmin), 10rem); text-align: start; }
      }
      h1 {
        font-size: clamp(var(--h1), calc(0.25rem + 5vw), 4rem);
        line-height: 1.2;
        font-weight: 600;
        color: var(--heading);
      }
      .tagline { font-size: clamp(1rem, calc(0.0625rem + 2vw), 1.25rem); }
    </style>
  </head>
  <body>
    <header><a href="/" class="site-title" translate="no">Onden</a></header>
    <main>
      <div class="hero">
        <h1>404</h1>
        <div class="tagline">Page not found. Check the URL.</div>
      </div>
    </main>
  </body>
</html>
