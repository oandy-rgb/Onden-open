{
  "name": "@onden/markdown",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "description": "Onden's one Markdown pipeline: remark/rehype plugins + sanitize schema shared by the app and the server exports.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./src/sharedContract.ts",
      "default": "./dist/sharedContract.js"
    },
    "./slug": {
      "types": "./src/slug.ts",
      "default": "./dist/slug.js"
    },
    "./ink": {
      "types": "./src/ink.ts",
      "default": "./dist/ink.js"
    },
    "./page-text": {
      "types": "./src/pageText.ts",
      "default": "./dist/pageText.js"
    },
    "./page-images": {
      "types": "./src/pageImages.ts",
      "default": "./dist/pageImages.js"
    },
    "./full": {
      "types": "./src/full.ts",
      "default": "./dist/full.js"
    },
    "./snippet": {
      "types": "./src/snippet.ts",
      "default": "./dist/snippet.js"
    },
    "./media-enhance": {
      "types": "./src/mediaEnhance.ts",
      "default": "./dist/mediaEnhance.js"
    },
    "./steps-enhance": {
      "types": "./src/stepsEnhance.ts",
      "default": "./dist/stepsEnhance.js"
    },
    "./block-id": {
      "types": "./src/blockId.ts",
      "default": "./dist/blockId.js"
    },
    "./task-parse": {
      "types": "./src/taskParse.ts",
      "default": "./dist/taskParse.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gen:grammars": "node scripts/genGrammars.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:props": "vitest run src/test/properties",
    "test:props:long": "S=${PROPS_SEED:-$(date +%Y%m%d)}; echo \"PROPS_SEED=$S (replay: PROPS_SEED=$S PROPS_RUNS=5000)\"; PROPS_SEED=$S PROPS_RUNS=5000 vitest run src/test/properties",
    "test:fuzz": "vitest run --config vitest.fuzz.config.ts",
    "test:fuzz:long": "FUZZ_LONG=1 vitest run --config vitest.fuzz.config.ts",
    "test:mutation": "stryker run",
    "test:mutation:file": "stryker run --mutate"
  },
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "hast-util-to-text": "^4.0.2",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-gfm-strikethrough": "^2.0.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "micromark-extension-cjk-friendly": "^2.0.2",
    "micromark-extension-cjk-friendly-util": "^3.0.1",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "patch-package": "^8.0.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-wiki-link": "^2.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "fast-check": "^4.8.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-util-types": "^2.0.2",
    "rehype-stringify": "^10.0.1",
    "remark-rehype": "^11.1.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  }
}
