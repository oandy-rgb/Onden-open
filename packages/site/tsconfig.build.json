{
  // Emits dist/ for the backend's production image: the React-free entry only
  // (./react is bundled from source by the frontend). Reads @onden/markdown's
  // built declarations, so build that package first (npm run build does).
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": { "@onden/markdown": ["../markdown/dist/index.d.ts"], "@onden/markdown/block-id": ["../markdown/dist/blockId.d.ts"] }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/react/**", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
